  placeholder?: string,
  disabled?: bool,
  error?: bool,
  errorMessage?: string,
  allowClear?: bool,
  size?: HighchartsSharedTypes.dateRangePickerSize,
  triggerConfig?: HighchartsSharedTypes.triggerConfig,
  popoverConfig?: HighchartsSharedTypes.dateRangePickerPopoverConfig,
}
