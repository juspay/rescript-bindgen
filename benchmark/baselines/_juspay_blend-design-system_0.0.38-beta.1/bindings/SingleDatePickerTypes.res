  minDate?: Date.t,
  maxDate?: Date.t,
  granularity?: SharedTypes.pickerGranularity,
  disableDates?: Date.t => bool,
  showTime?: bool,
  timeFormat?: DateRangePickerTypes.dateRangePickerDateFormatConfigTimeFormat,
  showSeconds?: bool,
  timezone?: string,
  dateFormat?: string,
  formatConfig?: DateRangePickerTypes.dateFormatConfig,
  placeholder?: string,
  disabled?: bool,
  error?: bool,
  errorMessage?: string,
  allowClear?: bool,
  size?: DateRangePickerTypes.dateRangePickerSize,
  triggerConfig?: DateRangePickerTypes.triggerConfig,
  popoverConfig?: DateRangePickerTypes.dateRangePickerPopoverConfig,
}
